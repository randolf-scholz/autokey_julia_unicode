{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Icon TSV schema definition",
    "description": "Validates required-column declarations and column specifications. Required column names must reference defined columns; this relationship, TSV contents, and regex semantics require separate validation.",
    "type": "object",
    "additionalProperties": true,
    "required": ["format", "columns"],
    "properties": {
        "format": {
            "type": "object",
            "additionalProperties": true,
            "required": ["required_columns"],
            "properties": {
                "required_columns": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
                }
            }
        },
        "columns": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
            "additionalProperties": { "$ref": "#/$defs/column" }
        }
    },
    "$defs": {
        "column": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allow_empty", "description", "item_pattern"],
            "properties": {
                "allow_empty": { "type": "boolean" },
                "list_separator": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "min_items": { "type": "integer", "minimum": 0 },
                "item_pattern": { "type": "string", "minLength": 1 },
                "unique_items": { "type": "boolean" },
                "examples": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string" }
                }
            },
            "allOf": [
                {
                    "if": { "not": { "required": ["list_separator"] } },
                    "then": {
                        "not": {
                            "anyOf": [
                                { "required": ["min_items"] },
                                { "required": ["unique_items"] }
                            ]
                        }
                    }
                },
                {
                    "if": {
                        "required": ["list_separator"],
                        "properties": { "allow_empty": { "const": false } }
                    },
                    "then": {
                        "required": ["min_items"],
                        "properties": { "min_items": { "minimum": 1 } }
                    }
                }
            ]
        }
    }
}
